<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chat.mapper.CommentMapper">
    <select id="findByVideoId" resultType="Comment">
        SELECT c.*, u.nickname, u.avatar
        FROM `comment` c
        LEFT JOIN `user` u ON c.user_id = u.id
        WHERE c.video_id = #{videoId}
        ORDER BY c.created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countByVideoId" resultType="int">
        SELECT COUNT(*) FROM `comment` WHERE video_id = #{videoId}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `comment`(video_id, user_id, content) VALUES(#{videoId}, #{userId}, #{content})
    </insert>
    <delete id="deleteById">
        DELETE FROM `comment` WHERE id = #{id}
    </delete>
    <delete id="deleteByVideoIds">
        DELETE FROM `comment` WHERE video_id IN
        <foreach collection="videoIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
